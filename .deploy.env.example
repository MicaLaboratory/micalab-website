# Copy to .deploy.env (git-ignored) and fill in from the IONOS control panel:
# Hosting > SFTP & SSH. The password goes in the macOS keychain, not here.
DEPLOY_HOST=access000000000.webspace-data.io
DEPLOY_USER=u00000000
# Folder on the webspace that micalab.org serves: / if the site is at the root
DEPLOY_PATH=/
